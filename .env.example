PORT=3000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
CACHE_TTL_SECONDS=600

# Where the worker and the health check reach the suppliers (the app serves the mocks itself)
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
SUPPLIER_REQUEST_TIMEOUT_MS=2500

# Failure simulation (read by the app process that serves the mock suppliers)
SUPPLIER_A_FAIL=false
SUPPLIER_B_FAIL=false
SUPPLIER_A_DELAY_MS=0
SUPPLIER_B_DELAY_MS=0
