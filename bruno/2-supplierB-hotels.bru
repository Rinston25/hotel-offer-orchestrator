meta {
  name: Supplier B hotels
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/supplierB/hotels?city=delhi
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns hotels with the expected fields", function () {
    expect(res.body.length).to.be.greaterThan(0);
    expect(res.body[0]).to.have.all.keys("hotelId", "name", "price", "city", "commissionPct");
  });
}
