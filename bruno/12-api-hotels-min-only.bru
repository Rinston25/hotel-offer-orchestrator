meta {
  name: Price range - minPrice only
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/hotels?city=delhi&minPrice=6000
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("no hotel below minPrice", function () {
    expect(res.body.length).to.be.greaterThan(0);
    res.body.forEach((h) => expect(h.price).to.be.at.least(6000));
  });
}
