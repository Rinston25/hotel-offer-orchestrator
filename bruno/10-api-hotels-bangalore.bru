meta {
  name: Search hotels - Bangalore (case-insensitive names)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/hotels?city=Bangalore
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("city is case-insensitive", function () {
    expect(res.body.length).to.be.greaterThan(0);
  });

  test("Tech Park Lodge matches despite leading whitespace and keeps Supplier A at 3600", function () {
    const matches = res.body.filter((h) => h.name.trim().toLowerCase() === "tech park lodge");
    expect(matches).to.have.length(1);
    expect(matches[0]).to.include({ price: 3600, supplier: "Supplier A" });
  });
}
